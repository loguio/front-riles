# Modèle de configuration — copiez ce fichier vers .env puis renseignez vos
# propres valeurs. NE JAMAIS committer .env (ignoré par .gitignore).
#
# ⚠️ RILES-009 : les clés qui figuraient dans le .env versionné ont été
# exposées dans l'historique git. Elles doivent être régénérées (rotation)
# côté propriétaire, depuis les tableaux de bord :
#   - Supabase : Project Settings > API keys (clé publishable/anon)
#   - PostHog  : Project settings > Project API Key
# Cette rotation ne peut pas être effectuée depuis le dépôt.

# API Backend NestJS
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Supabase (Project settings -> API)
EXPO_PUBLIC_SUPABASE_PROJECT_REF=your_supabase_project_ref
EXPO_PUBLIC_SUPABASE_URL=https://your_supabase_project_ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_posthog_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
